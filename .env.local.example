# Copy to .env.local and fill in. Same Supabase project as the vehicle app.
# In Vercel, set these as project Environment Variables instead.

# Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key — SERVER ONLY. Grants full DB access; never expose to client.
# Used by the /found pages and the importer to read legacy_tags with RLS bypassed.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key — needed to READ the shared login session (owner auto-redirect).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set in PROD on BOTH apps so the login session is shared across subdomains.
# Leave UNSET locally. Value: .securetag.in
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=

# Where owners manage items (the main site). Defaults to https://securetag.in.
NEXT_PUBLIC_MANAGE_ORIGIN=
