# Copy to .env.local and fill in. Same Supabase project as the vehicle app.
# In Vercel, set these two as project Environment Variables instead.

# Supabase project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Service-role key — SERVER ONLY. Grants full DB access; never expose to the client.
# Used by the /found pages and the importer to read legacy_tags with RLS bypassed.
SUPABASE_SERVICE_ROLE_KEY=
